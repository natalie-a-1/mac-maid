      "Xcode DerivedData (≈ $(kb_to_gb "$XD_KB") GB)"
      "iOS Simulator data (≈ $(kb_to_gb "$SIM_KB") GB)"
      "Empty Trash (≈ $(kb_to_gb "$TR_KB") GB)"
      "Project junk (node_modules/.next/dist/build/...)"
      "Python venvs (.venv/venv/.tox)"
