#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# mac-maid — a clean, safe Mac storage cleaner (wizard + config + scheduling)
#
# Philosophy:
# - Safe by default. You opt in per category.
# - Dry-run shows what would happen.
# - Never touches configs / keys. Targets caches + rebuildable dev artifacts.
# - Explicitly protects Ollama: never deletes ~/.ollama or ~/.cache/ollama
#
# Usage:
#   mac-maid                  # interactive wizard
#   mac-maid --dry-run        # wizard preview (no deletions / no scheduling)
#   mac-maid --run            # non-interactive run using config (default config path)
#   mac-maid --run --dry-run  # non-interactive preview using config
#
#   mac-maid --print-config   # prints example config
#   mac-maid --status         # shows schedule + last logs
#   mac-maid --install        # install LaunchAgent schedule from config
#   mac-maid --uninstall      # remove LaunchAgent schedule
#
# Config default:
#   ~/.config/mac-maid/config
#
# Logs default:
#   ~/.local/state/mac-maid/logs/
# ==============================================================================

APP_NAME="mac-maid"
APP_TITLE="Mac Maid"
VERSION="0.1.0"

LABEL_MAIN="com.macmaid.clean"
LABEL_LOGIN="com.macmaid.login-summary"

DEFAULT_CONF="$HOME/.config/mac-maid/config"
DEFAULT_LOG_DIR="$HOME/.local/state/mac-maid/logs"

# ---------------------------
# Styling
# ---------------------------
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
  C=$'\033[36m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; GR=$'\033[90m'
else
  BOLD=""; DIM=""; RESET=""; C=""; G=""; Y=""; R=""; GR=""
fi

hr()    { printf "%s\n" "${GR}────────────────────────────────────────────────────────────${RESET}"; }
title() { hr; printf "${BOLD}${C}%s${RESET}\n" "$1"; hr; }
ok()    { printf "${G}✓${RESET} %s\n" "$1"; }
warn()  { printf "${Y}!${RESET} %s\n" "$1"; }
fail()  { printf "${R}✗${RESET} %s\n" "$1"; }
note()  { printf "${GR}%s${RESET}\n" "$1"; }

have() { command -v "$1" >/dev/null 2>&1; }

prompt() {
  local msg="$1" def="${2:-}" ans=""
  if [[ -n "$def" ]]; then
    read -r -p "$msg [$def]: " ans || true
    echo "${ans:-$def}"
  else
    read -r -p "$msg: " ans || true
    echo "$ans"
  fi
}

confirm() {
  local msg="$1" def="${2:-N}" ans=""
  local hint="y/N"
  [[ "$def" == "Y" ]] && hint="Y/n"
  read -r -p "$msg ($hint): " ans || true
  ans="${ans:-$def}"
  [[ "$ans" =~ ^[Yy]$ ]]
}

kb_available_root() { df -k / | awk 'NR==2{print $4}'; }
kb_to_gb() { awk -v kb="${1:-0}" 'BEGIN{printf "%.2f", kb/1024/1024}'; }
du_kb() { [[ -e "$1" ]] && du -sk "$1" 2>/dev/null | awk '{print $1}' || echo 0; }
du_h()  { [[ -e "$1" ]] && du -sh "$1" 2>/dev/null | awk '{print $1}' || echo "0B"; }

abs_path() {
  local p="$1"
  if [[ "$p" == /* ]]; then echo "$p"; return 0; fi
  echo "$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
}

SCRIPT_PATH="$(abs_path "$0")"

# ---------------------------
# Modes / args
# ---------------------------
MODE="wizard"          # wizard|run|print-config|install|uninstall|status
DRY_RUN=0
CONF_PATH="$DEFAULT_CONF"

# ---------------------------
# Config defaults (can be overridden by config file)
# ---------------------------
LOG_DIR="$DEFAULT_LOG_DIR"
NOTIFY_ON_COMPLETE=1
SHOW_LAST_RUN_ON_LOGIN=0

# Cleaning toggles
CLEAN_NPM=0
CLEAN_PNPM=0
CLEAN_PIP=0
CLEAN_HF=0
CLEAN_USER_CACHE=0
CLEAN_MAC_CACHES=0
CLEAN_HOMEBREW_CACHE=0
CLEAN_XCODE_DERIVED=0
CLEAN_IOS_SIM=0
CLEAN_TRASH=0
CLEAN_PROJECT_JUNK=0
CLEAN_VENVS=0

# Project scan roots (colon-separated)
PROJECT_ROOTS="$HOME/Developer:$HOME/Projects:$HOME/code:$HOME/src"

# Scheduling
SCHEDULE_ENABLED=0
SCHEDULE_MODE="daily"      # daily|weekly
SCHEDULE_TIME="05:00"      # HH:MM 24-hour
SCHEDULE_WEEKDAY="2"       # 1=Sun..7=Sat (weekly only)

# Wake/Sleep automation (optional)
ALLOW_WAKE=0
WAKE_TIME="04:58:00"
SLEEP_TIME="05:20:00"

# ---------------------------
# Logging
# ---------------------------
RUN_ID="$(date +%Y%m%d_%H%M%S)"
RUN_LOG=""  # set per-run

mkdir -p "$LOG_DIR" >/dev/null 2>&1 || true

log_init() {
  mkdir -p "$LOG_DIR" >/dev/null 2>&1 || true
  RUN_LOG="$LOG_DIR/run-${RUN_ID}.log"
  {
    echo "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "┃ ${APP_TITLE} — Run Log"
    echo "┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "┃ Version : ${VERSION}"
    echo "┃ Started : $(date '+%Y-%m-%d %H:%M:%S')"
    echo "┃ Host    : $(scutil --get ComputerName 2>/dev/null || hostname)"
    echo "┃ User    : $USER"
    echo "┃ Mode    : $MODE"
    echo "┃ Dry Run : $DRY_RUN"
    echo "┃ Config  : $CONF_PATH"
    echo "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo
  } >> "$RUN_LOG"
}

log_section(){ echo "━━ $1" >> "$RUN_LOG"; }
log_line(){ echo " • $1" >> "$RUN_LOG"; }
log_kv(){ printf "   %-24s %s\n" "$1" "$2" >> "$RUN_LOG"; }
log_done(){
  {
    echo
    echo "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "┃ Finished: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  } >> "$RUN_LOG"
}

notify() {
  local msg="$1"
  [[ "${NOTIFY_ON_COMPLETE}" == "1" ]] || return 0
  /usr/bin/osascript -e "display notification \"${msg//\"/\\\"}\" with title \"${APP_TITLE}\"" >/dev/null 2>&1 || true
}

# ---------------------------
# Safety rails
# ---------------------------
is_safe_path() {
  local p="$1"
  [[ -n "$p" ]] || return 1
  [[ "$p" == "$HOME" ]] && return 1
  [[ "$p" == "/" ]] && return 1
  [[ "$p" == "$HOME/"* ]] || return 1
  return 0
}

# Protect Ollama hard:
is_protected_path() {
  local p="$1"
  case "$p" in
    "$HOME/.ollama"* ) return 0 ;;
    "$HOME/.cache/ollama"* ) return 0 ;;
  esac
  return 1
}

do_cmd() {
  local desc="$1"; shift
  if [[ "$DRY_RUN" == "1" ]]; then
    log_line "[dry-run] Would run: $desc"
    return 0
  fi
  log_line "Run: $desc"
  "$@" >> "$RUN_LOG" 2>&1 || true
}

do_rm_rf() {
  local p="$1"
  if is_protected_path "$p"; then
    log_line "Skip protected: $p"
    return 0
  fi
  if ! is_safe_path "$p"; then
    log_line "Skip unsafe path: $p"
    return 0
  fi
  if [[ "$DRY_RUN" == "1" ]]; then
    log_line "[dry-run] Would remove: $p (size: $(du_h "$p"))"
    return 0
  fi
  log_line "Remove: $p (size: $(du_h "$p"))"
  rm -rf "$p" >> "$RUN_LOG" 2>&1 || true
}

do_rm_rf_glob() {
  # delete contents of a directory (dir itself stays)
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  if ! is_safe_path "$dir"; then
    log_line "Skip unsafe dir: $dir"
    return 0
  fi
  shopt -s dotglob nullglob
  local items=("$dir"/*)
  shopt -u dotglob nullglob
  if [[ "${#items[@]}" -eq 0 ]]; then return 0; fi
  for p in "${items[@]}"; do
    do_rm_rf "$p"
  done
}

# ---------------------------
# Snapshot
# ---------------------------
audit_snapshot() {
  title "${APP_TITLE} — Storage Snapshot"
  df -h / | awk 'NR==1{print $0} NR==2{printf "Disk: Used %s / %s | Available %s\n", $3, $2, $4}'
  echo
  echo "${BOLD}Largest folders in Home (top 10, depth 2):${RESET}"
  du -x -k -d 2 "$HOME" 2>/dev/null | sort -nr | head -n 10 \
    | awk '{printf "  %7.1f GB\t%s\n",$1/1024/1024,$2}'
  echo
}

# ---------------------------
# Category sizing helpers
# ---------------------------
size_npm_kb(){ du_kb "$HOME/.npm"; }
size_pnpm_kb(){
  local a b
  a="$(du_kb "$HOME/.pnpm-store")"
  b="$(du_kb "$HOME/Library/pnpm")"
  echo $(( a + b ))
}
size_pip_kb(){
  local d
  d="$(python3 -m pip cache dir 2>/dev/null || true)"
  [[ -n "$d" ]] && du_kb "$d" || du_kb "$HOME/Library/Caches/pip"
}
size_hf_kb(){ du_kb "$HOME/.cache/huggingface"; }
size_usercache_kb(){ du_kb "$HOME/.cache"; }
size_maccache_kb(){ du_kb "$HOME/Library/Caches"; }
size_brewcache_kb(){
  if have brew; then
    du_kb "$(brew --cache 2>/dev/null || echo "$HOME/Library/Caches/Homebrew")"
  else
    du_kb "$HOME/Library/Caches/Homebrew"
  fi
}
size_xcode_kb(){ du_kb "$HOME/Library/Developer/Xcode/DerivedData"; }
size_iossim_kb(){ du_kb "$HOME/Library/Developer/CoreSimulator"; }
size_trash_kb(){ du_kb "$HOME/.Trash"; }

# ---------------------------
# Project junk + venv discovery
# ---------------------------
find_project_junk() {
  local roots_str="$1"
  local -a roots
  IFS=":" read -r -a roots <<< "$roots_str"
  for r in "${roots[@]}"; do
    [[ -d "$r" ]] || continue
    # common build / cache dirs
    find "$r" -type d \( \
      -name node_modules -o -name .next -o -name dist -o -name build -o -name .turbo -o -name .cache -o -name coverage \
      -o -name __pycache__ \
    \) -prune -print 2>/dev/null
  done | sort -u
}

find_venvs() {
  local roots_str="$1"
  local -a roots
  IFS=":" read -r -a roots <<< "$roots_str"
  for r in "${roots[@]}"; do
    [[ -d "$r" ]] || continue
    find "$r" -type d \( -name ".venv" -o -name "venv" -o -name ".tox" \) -prune -print 2>/dev/null
  done | sort -u
}

sum_kb_from_list() {
  local total=0 p
  while IFS= read -r p; do
    total=$(( total + $(du_kb "$p") ))
  done
  echo "$total"
}

top10_from_list() {
  # prints "SIZE PATH" sorted by size, top 10
  local tmp
  tmp="$(mktemp)"
  while IFS= read -r p; do
    printf "%s\t%s\n" "$(du_kb "$p")" "$p" >> "$tmp"
  done
  sort -nr "$tmp" | head -n 10 | awk '{printf "  %7.2f GB  %s\n",$1/1024/1024,$2}'
  rm -f "$tmp"
}

# ---------------------------
# Clean tasks
# ---------------------------
task_npm() {
  log_section "NPM cache"
  if have npm; then
    do_cmd "npm cache clean --force" npm cache clean --force
    do_rm_rf "$HOME/.npm/_cacache"
    do_rm_rf "$HOME/.npm/_npx"
  else
    log_line "npm not found → skip"
  fi
}

task_pnpm() {
  log_section "PNPM store"
  if have pnpm; then
    do_cmd "pnpm store prune" pnpm store prune
  else
    log_line "pnpm not found → skip"
  fi
}

task_pip() {
  log_section "PIP cache"
  if have python3; then
    do_cmd "python3 -m pip cache purge" python3 -m pip cache purge
  else
    log_line "python3 not found → skip"
  fi
}

task_hf() {
  log_section "Hugging Face cache"
  do_rm_rf "$HOME/.cache/huggingface"
}

task_user_cache() {
  # Cleans ~/.cache/* excluding ollama + huggingface
  log_section "~/.cache (general, Ollama-safe)"
  local d="$HOME/.cache"
  [[ -d "$d" ]] || { log_line "~/.cache not found → skip"; return 0; }
  shopt -s dotglob nullglob
  for p in "$d"/*; do
    local base; base="$(basename "$p")"
    case "$base" in
      ollama|huggingface) log_line "Skip protected cache: $p"; continue ;;
    esac
    do_rm_rf "$p"
  done
  shopt -u dotglob nullglob
}

task_mac_caches() {
  # Best-effort: skip Apple protected + browser/session + known permission trouble
  log_section "~/Library/Caches (best-effort)"
  local d="$HOME/Library/Caches"
  [[ -d "$d" ]] || { log_line "~/Library/Caches not found → skip"; return 0; }
  shopt -s dotglob nullglob
  for p in "$d"/*; do
    local base; base="$(basename "$p")"
    case "$base" in
      com.apple.*|CloudKit|FamilyCircle) log_line "Skip protected: $p"; continue ;;
      com.google.Chrome|com.apple.Safari|com.openai.atlas) log_line "Skip browser/session cache: $p"; continue ;;
      PanGPS) log_line "Skip permission-locked: $p"; continue ;;
    esac
    do_rm_rf "$p"
  done
  shopt -u dotglob nullglob
}

task_brew_cache() {
  log_section "Homebrew cache"
  if have brew; then
    local c; c="$(brew --cache 2>/dev/null || true)"
    [[ -n "$c" ]] && do_rm_rf_glob "$c" || do_rm_rf_glob "$HOME/Library/Caches/Homebrew"
  else
    do_rm_rf_glob "$HOME/Library/Caches/Homebrew"
  fi
}

task_xcode_derived() {
  log_section "Xcode DerivedData"
  do_rm_rf_glob "$HOME/Library/Developer/Xcode/DerivedData"
}

task_ios_sim() {
  log_section "iOS Simulator data"
  # Safer: delete only device caches, not everything (still big)
  # Many people simply delete CoreSimulator; we keep it opt-in.
  do_rm_rf_glob "$HOME/Library/Developer/CoreSimulator"
}

task_trash() {
  log_section "Trash"
  do_rm_rf_glob "$HOME/.Trash"
}

task_project_junk() {
  log_section "Project junk (node_modules, build, dist, .next, caches)"
  local roots="$PROJECT_ROOTS"
  log_line "Scan roots: $roots"
  while IFS= read -r p; do
    do_rm_rf "$p"
  done < <(find_project_junk "$roots")
}

task_venvs() {
  log_section "Python venvs (.venv/venv/.tox)"
  local roots="$PROJECT_ROOTS"
  log_line "Scan roots: $roots"
  while IFS= read -r p; do
    do_rm_rf "$p"
  done < <(find_venvs "$roots")
}

# ---------------------------
# Config file
# ---------------------------
print_config() {
  cat <<CFG
# ${APP_TITLE} config (${VERSION})
# Save as: ${CONF_PATH}
#
# 0=off, 1=on
#
# Safety:
# - Never deletes ~/.ollama or ~/.cache/ollama
# - Avoids ~/.config, ~/.ssh, ~/Library/Application Support, etc.

LOG_DIR="${LOG_DIR}"
NOTIFY_ON_COMPLETE=${NOTIFY_ON_COMPLETE}
SHOW_LAST_RUN_ON_LOGIN=${SHOW_LAST_RUN_ON_LOGIN}

CLEAN_NPM=${CLEAN_NPM}
CLEAN_PNPM=${CLEAN_PNPM}
CLEAN_PIP=${CLEAN_PIP}
CLEAN_HF=${CLEAN_HF}
CLEAN_USER_CACHE=${CLEAN_USER_CACHE}
CLEAN_MAC_CACHES=${CLEAN_MAC_CACHES}
CLEAN_HOMEBREW_CACHE=${CLEAN_HOMEBREW_CACHE}
CLEAN_XCODE_DERIVED=${CLEAN_XCODE_DERIVED}
CLEAN_IOS_SIM=${CLEAN_IOS_SIM}
CLEAN_TRASH=${CLEAN_TRASH}
CLEAN_PROJECT_JUNK=${CLEAN_PROJECT_JUNK}
CLEAN_VENVS=${CLEAN_VENVS}

PROJECT_ROOTS="${PROJECT_ROOTS}"

SCHEDULE_ENABLED=${SCHEDULE_ENABLED}
SCHEDULE_MODE="${SCHEDULE_MODE}"      # daily|weekly
SCHEDULE_TIME="${SCHEDULE_TIME}"      # HH:MM
SCHEDULE_WEEKDAY="${SCHEDULE_WEEKDAY}"# 1=Sun..7=Sat

ALLOW_WAKE=${ALLOW_WAKE}
WAKE_TIME="${WAKE_TIME}"              # HH:MM:SS
SLEEP_TIME="${SLEEP_TIME}"            # HH:MM:SS
CFG
}

write_config() {
  mkdir -p "$(dirname "$CONF_PATH")" >/dev/null 2>&1 || true
  mkdir -p "$LOG_DIR" >/dev/null 2>&1 || true
  print_config > "$CONF_PATH"
  ok "Config saved: $CONF_PATH"
}

load_config() {
  # shellcheck disable=SC1090
  source "$CONF_PATH"
}

# ---------------------------
# LaunchAgent scheduling
# ---------------------------
plist_main_path(){ echo "$HOME/Library/LaunchAgents/${LABEL_MAIN}.plist"; }
plist_login_path(){ echo "$HOME/Library/LaunchAgents/${LABEL_LOGIN}.plist"; }

time_hour(){ echo "${SCHEDULE_TIME%:*}"; }
time_min(){ echo "${SCHEDULE_TIME#*:}"; }

print_plist_main() {
  local hour minute start_block
  hour="$(time_hour)"; minute="$(time_min)"
  if [[ "$SCHEDULE_MODE" == "weekly" ]]; then
    start_block="<dict><key>Weekday</key><integer>${SCHEDULE_WEEKDAY}</integer><key>Hour</key><integer>${hour}</integer><key>Minute</key><integer>${minute}</integer></dict>"
  else
    start_block="<dict><key>Hour</key><integer>${hour}</integer><key>Minute</key><integer>${minute}</integer></dict>"
  fi

  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
  <dict>
    <key>Label</key><string>${LABEL_MAIN}</string>
    <key>ProgramArguments</key>
    <array>
      <string>${SCRIPT_PATH}</string>
      <string>--run</string>
      <string>--conf</string>
      <string>${CONF_PATH}</string>
    </array>
    <key>StartCalendarInterval</key>
    ${start_block}
    <key>WakeSystem</key><true/>
    <key>StandardOutPath</key><string>${LOG_DIR}/launchd.out</string>
    <key>StandardErrorPath</key><string>${LOG_DIR}/launchd.err</string>
  </dict>
</plist>
PLIST
}

install_launchagent_main() {
  mkdir -p "$HOME/Library/LaunchAgents" >/dev/null 2>&1 || true
  local plist; plist="$(plist_main_path)"

  if [[ "$DRY_RUN" == "1" ]]; then
    warn "Dry-run: would install LaunchAgent at: $plist"
    print_plist_main | sed 's/^/  /'
    return 0
  fi

  print_plist_main > "$plist"

  local uid; uid="$(id -u)"
  # unload old if present
  launchctl bootout "gui/${uid}" "$plist" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/${uid}" "$plist" >/dev/null 2>&1 || true
  ok "Scheduled via LaunchAgent: $plist"
  note "LaunchAgents run when you are logged in. Lid closed is fine; powered off is not."
}

install_login_summary() {
  [[ "$SHOW_LAST_RUN_ON_LOGIN" == "1" ]] || return 0
  mkdir -p "$HOME/Library/LaunchAgents" >/dev/null 2>&1 || true
  local plist; plist="$(plist_login_path)"

  if [[ "$DRY_RUN" == "1" ]]; then
    warn "Dry-run: would install login summary agent: $plist"
    return 0
  fi

  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
  <dict>
    <key>Label</key><string>${LABEL_LOGIN}</string>
    <key>RunAtLoad</key><true/>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>
        last_log=\$(ls -t "${LOG_DIR}"/run-*.log 2>/dev/null | head -n 1);
        if [[ -n "\$last_log" ]]; then
          summary=\$(grep -E "Freed ~" "\$last_log" 2>/dev/null | tail -n 1);
          /usr/bin/osascript -e "display notification \\"\${summary:-'mac-maid ran. See logs.'}\\" with title \\"${APP_TITLE}\\"" >/dev/null 2>&1;
        fi
      </string>
    </array>
  </dict>
</plist>
PLIST

  local uid; uid="$(id -u)"
  launchctl bootout "gui/${uid}" "$plist" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/${uid}" "$plist" >/dev/null 2>&1 || true
  ok "Login summary enabled: $plist"
}

install_pmset_wake() {
  [[ "$ALLOW_WAKE" == "1" ]] || return 0
  if [[ "$DRY_RUN" == "1" ]]; then
    warn "Dry-run: would set wake/sleep schedule via pmset:"
    echo "  sudo pmset repeat wakeorpoweron MTWRFSU ${WAKE_TIME} sleep MTWRFSU ${SLEEP_TIME}"
    return 0
  fi
  warn "Admin password needed once for pmset wake/sleep scheduling."
  sudo pmset repeat wakeorpoweron MTWRFSU "$WAKE_TIME" sleep MTWRFSU "$SLEEP_TIME" >/dev/null 2>&1 || true
  ok "Power schedule set. Check: pmset -g sched"
}

uninstall_schedule() {
  local uid; uid="$(id -u)"
  local p1 p2
  p1="$(plist_main_path)"; p2="$(plist_login_path)"

  if [[ "$DRY_RUN" == "1" ]]; then
    warn "Dry-run: would remove schedules + plist files:"
    echo "  $p1"
    echo "  $p2"
    echo "  launchctl remove ${LABEL_MAIN}"
    echo "  launchctl remove ${LABEL_LOGIN}"
    echo "  (optional) sudo pmset repeat cancel"
    return 0
  fi

  launchctl remove "${LABEL_MAIN}" >/dev/null 2>&1 || true
  launchctl remove "${LABEL_LOGIN}" >/dev/null 2>&1 || true
  rm -f "$p1" "$p2" >/dev/null 2>&1 || true
  ok "LaunchAgents removed."
  note "If you previously set pmset wake/sleep, remove it with: sudo pmset repeat cancel"
}

# ---------------------------
# Runner (uses toggles)
# ---------------------------
run_cleanup() {
  local before_kb after_kb freed_kb freed_gb
  before_kb="$(kb_available_root)"

  log_init
  log_section "Disk"
  log_line "Before: $(df -h / | awk 'NR==2{print "Used "$3" / "$2" | Available "$4}')"

  log_section "Plan"
  log_kv "CLEAN_NPM" "$CLEAN_NPM"
  log_kv "CLEAN_PNPM" "$CLEAN_PNPM"
  log_kv "CLEAN_PIP" "$CLEAN_PIP"
  log_kv "CLEAN_HF" "$CLEAN_HF"
  log_kv "CLEAN_USER_CACHE" "$CLEAN_USER_CACHE"
  log_kv "CLEAN_MAC_CACHES" "$CLEAN_MAC_CACHES"
  log_kv "CLEAN_HOMEBREW_CACHE" "$CLEAN_HOMEBREW_CACHE"
  log_kv "CLEAN_XCODE_DERIVED" "$CLEAN_XCODE_DERIVED"
  log_kv "CLEAN_IOS_SIM" "$CLEAN_IOS_SIM"
  log_kv "CLEAN_TRASH" "$CLEAN_TRASH"
  log_kv "CLEAN_PROJECT_JUNK" "$CLEAN_PROJECT_JUNK"
  log_kv "CLEAN_VENVS" "$CLEAN_VENVS"
  echo >> "$RUN_LOG"

  [[ "$CLEAN_NPM" == "1" ]] && task_npm && echo >> "$RUN_LOG"
  [[ "$CLEAN_PNPM" == "1" ]] && task_pnpm && echo >> "$RUN_LOG"
  [[ "$CLEAN_PIP" == "1" ]] && task_pip && echo >> "$RUN_LOG"
  [[ "$CLEAN_HF" == "1" ]] && task_hf && echo >> "$RUN_LOG"
  [[ "$CLEAN_USER_CACHE" == "1" ]] && task_user_cache && echo >> "$RUN_LOG"
  [[ "$CLEAN_MAC_CACHES" == "1" ]] && task_mac_caches && echo >> "$RUN_LOG"
  [[ "$CLEAN_HOMEBREW_CACHE" == "1" ]] && task_brew_cache && echo >> "$RUN_LOG"
  [[ "$CLEAN_XCODE_DERIVED" == "1" ]] && task_xcode_derived && echo >> "$RUN_LOG"
  [[ "$CLEAN_IOS_SIM" == "1" ]] && task_ios_sim && echo >> "$RUN_LOG"
  [[ "$CLEAN_TRASH" == "1" ]] && task_trash && echo >> "$RUN_LOG"
  [[ "$CLEAN_PROJECT_JUNK" == "1" ]] && task_project_junk && echo >> "$RUN_LOG"
  [[ "$CLEAN_VENVS" == "1" ]] && task_venvs && echo >> "$RUN_LOG"

  after_kb="$(kb_available_root)"
  freed_kb=$(( after_kb - before_kb ))
  freed_gb="$(kb_to_gb "$freed_kb")"

  log_section "Disk"
  log_line "After : $(df -h / | awk 'NR==2{print "Used "$3" / "$2" | Available "$4}')"
  log_line "Freed ~${freed_gb} GB (approx; filesystem reporting varies)"
  log_done

  ok "Done. Freed ~${freed_gb} GB (approx)."
  ok "Log: $RUN_LOG"
  notify "Cleanup finished. Freed ~${freed_gb} GB."
}

# ---------------------------
# Wizard
# ---------------------------
wizard() {
  audit_snapshot

  title "${APP_TITLE} — Wizard"
  if [[ "$DRY_RUN" == "1" ]]; then
    warn "Dry-run is ON: no deletions, no scheduling changes."
  else
    note "Tip: start with --dry-run to preview safely."
  fi
  echo

  # Ask logging preferences
  title "${APP_TITLE} — Logs"
  LOG_DIR="$(prompt "Log folder" "$LOG_DIR")"
  mkdir -p "$LOG_DIR" >/dev/null 2>&1 || true

  NOTIFY_ON_COMPLETE=1
  confirm "Show a macOS notification when finished?" "Y" || NOTIFY_ON_COMPLETE=0

  SHOW_LAST_RUN_ON_LOGIN=0
  confirm "Show a short 'last run' notification at next login?" "N" && SHOW_LAST_RUN_ON_LOGIN=1
  echo

  # Compute sizes
  local npm_kb pnpm_kb pip_kb hf_kb ucache_kb mcache_kb brew_kb xcode_kb sim_kb trash_kb pj_kb venv_kb
  npm_kb="$(size_npm_kb)"
  pnpm_kb="$(size_pnpm_kb)"
  pip_kb="$(size_pip_kb)"
  hf_kb="$(size_hf_kb)"
  ucache_kb="$(size_usercache_kb)"
  mcache_kb="$(size_maccache_kb)"
  brew_kb="$(size_brewcache_kb)"
  xcode_kb="$(size_xcode_kb)"
  sim_kb="$(size_iossim_kb)"
  trash_kb="$(size_trash_kb)"

  # Project junk sizing can be slow; only compute if user wants to consider it.
  pj_kb=0
  venv_kb=0

  title "${APP_TITLE} — Choose What to Clean"
  note "Each category is explained. You opt in. Defaults are conservative."
  echo

  CLEAN_NPM=0
  echo "${BOLD}NPM cache${RESET} — safe; rebuilds on next install. Current: $(kb_to_gb "$npm_kb") GB"
  confirm "Enable NPM cache clean?" "Y" && CLEAN_NPM=1
  echo

  CLEAN_PNPM=0
  echo "${BOLD}PNPM store${RESET} — safe; prunes unused packages. Current: $(kb_to_gb "$pnpm_kb") GB"
  confirm "Enable PNPM store prune?" "Y" && CLEAN_PNPM=1
  echo

  CLEAN_PIP=0
  echo "${BOLD}PIP cache${RESET} — safe; re-downloads wheels later. Current: $(kb_to_gb "$pip_kb") GB"
  confirm "Enable PIP cache purge?" "N" && CLEAN_PIP=1
  echo

  CLEAN_HF=0
  echo "${BOLD}Hugging Face cache${RESET} — can be big; re-downloads models/datasets. Current: $(kb_to_gb "$hf_kb") GB"
  confirm "Enable Hugging Face cache removal?" "N" && CLEAN_HF=1
  echo

  CLEAN_USER_CACHE=0
  echo "${BOLD}~/.cache (general)${RESET} — misc dev caches. Current: $(kb_to_gb "$ucache_kb") GB"
  note "Ollama protected: never touches ~/.ollama or ~/.cache/ollama."
  confirm "Enable ~/.cache cleanup (Ollama-safe)?" "N" && CLEAN_USER_CACHE=1
  echo

  CLEAN_MAC_CACHES=0
  echo "${BOLD}~/Library/Caches (best-effort)${RESET} — may log you out of some apps. Current: $(kb_to_gb "$mcache_kb") GB"
  note "We skip Apple protected folders + browser/session-heavy caches."
  confirm "Enable ~/Library/Caches cleanup?" "N" && CLEAN_MAC_CACHES=1
  echo

  CLEAN_HOMEBREW_CACHE=0
  echo "${BOLD}Homebrew cache${RESET} — safe; re-downloads bottles. Current: $(kb_to_gb "$brew_kb") GB"
  confirm "Enable Homebrew cache cleanup?" "N" && CLEAN_HOMEBREW_CACHE=1
  echo

  CLEAN_XCODE_DERIVED=0
  echo "${BOLD}Xcode DerivedData${RESET} — safe; rebuilds indexes/build products. Current: $(kb_to_gb "$xcode_kb") GB"
  confirm "Enable Xcode DerivedData cleanup?" "N" && CLEAN_XCODE_DERIVED=1
  echo

  CLEAN_IOS_SIM=0
  echo "${BOLD}iOS Simulator data${RESET} — large; will rebuild, may reset sims. Current: $(kb_to_gb "$sim_kb") GB"
  confirm "Enable iOS Simulator cleanup?" "N" && CLEAN_IOS_SIM=1
  echo

  CLEAN_TRASH=0
  echo "${BOLD}Trash${RESET} — permanently deletes items in Trash. Current: $(kb_to_gb "$trash_kb") GB"
  confirm "Empty Trash?" "N" && CLEAN_TRASH=1
  echo

  CLEAN_PROJECT_JUNK=0
  CLEAN_VENVS=0
  if confirm "Consider cleaning project junk (node_modules/build/dist/.next/etc)?" "Y"; then
    PROJECT_ROOTS="$(prompt "Project roots (colon-separated)" "$PROJECT_ROOTS")"
    title "${APP_TITLE} — Scanning Project Junk"
    note "This can take a bit if you have many repos."
    pj_kb="$(find_project_junk "$PROJECT_ROOTS" | sum_kb_from_list)"
    echo "Found ~$(kb_to_gb "$pj_kb") GB of project junk."
    echo "Largest (top 10):"
    find_project_junk "$PROJECT_ROOTS" | top10_from_list
    echo
    confirm "Enable deleting project junk?" "N" && CLEAN_PROJECT_JUNK=1
    echo

    if confirm "Also scan/delete Python venvs (.venv/venv/.tox) in those roots?" "N"; then
      venv_kb="$(find_venvs "$PROJECT_ROOTS" | sum_kb_from_list)"
      echo "Found ~$(kb_to_gb "$venv_kb") GB of venvs."
      echo "Largest (top 10):"
      find_venvs "$PROJECT_ROOTS" | top10_from_list
      echo
      confirm "Enable deleting ALL discovered venvs?" "N" && CLEAN_VENVS=1
      echo
    fi
  fi

  # Config path
  title "${APP_TITLE} — Save Config"
  CONF_PATH="$(prompt "Config path" "$CONF_PATH")"
  echo
  echo "${BOLD}Config preview:${RESET}"
  print_config | sed 's/^/  /'
  echo

  if confirm "Write this config to disk now?" "Y"; then
    write_config
  else
    warn "Config not written (you can still run one-time in-memory)."
  fi
  echo

  # One-time run now
  title "${APP_TITLE} — Run Now"
  if confirm "Run cleanup now?" "Y"; then
    run_cleanup
  else
    warn "Skipped cleanup."
  fi
  echo

  # Scheduling
  title "${APP_TITLE} — Schedule"
  SCHEDULE_ENABLED=0
  if confirm "Set up automatic schedule (LaunchAgent)?" "N"; then
    SCHEDULE_ENABLED=1
    echo "  1) Daily"
    echo "  2) Weekly"
    local freq; freq="$(prompt "Choose frequency" "1")"
    if [[ "$freq" == "2" ]]; then
      SCHEDULE_MODE="weekly"
      note "Weekday: 1=Sun 2=Mon 3=Tue 4=Wed 5=Thu 6=Fri 7=Sat"
      SCHEDULE_WEEKDAY="$(prompt "Weekday" "2")"
    else
      SCHEDULE_MODE="daily"
    fi
    SCHEDULE_TIME="$(prompt "Run time (HH:MM, 24h)" "05:00")"

    ALLOW_WAKE=0
    if confirm "Also schedule wake/sleep via pmset (runs while you’re away)?" "Y"; then
      ALLOW_WAKE=1
      WAKE_TIME="$(prompt "Wake time (HH:MM:SS)" "04:58:00")"
      SLEEP_TIME="$(prompt "Sleep time (HH:MM:SS)" "05:20:00")"
    fi

    # Ensure config exists for scheduled runs
    if [[ "$DRY_RUN" != "1" ]]; then
      if [[ ! -f "$CONF_PATH" ]]; then
        warn "Config missing at $CONF_PATH; writing it now for scheduled runs."
        write_config
      fi
    fi

    # Install schedule (preview in dry-run)
    install_launchagent_main
    install_login_summary
    install_pmset_wake
  fi

  title "${APP_TITLE} — Done"
  if [[ "$DRY_RUN" == "1" ]]; then
    ok "Dry-run preview complete. Re-run without --dry-run to apply changes."
  else
    ok "All set."
  fi
  note "Nothing can run while the Mac is powered off. Sleep (lid closed) is fine if wake is scheduled."
}

# ---------------------------
# Status
# ---------------------------
show_status() {
  title "${APP_TITLE} — Status"
  echo "${BOLD}Config:${RESET} $CONF_PATH"
  [[ -f "$CONF_PATH" ]] && ok "Config exists" || warn "Config missing"
  echo
  echo "${BOLD}LaunchAgents:${RESET}"
  ls -la "$HOME/Library/LaunchAgents" 2>/dev/null | egrep "(${LABEL_MAIN}|${LABEL_LOGIN})" || echo "  (none found)"
  echo
  echo "${BOLD}pmset schedule:${RESET}"
  pmset -g sched 2>/dev/null || true
  echo
  echo "${BOLD}Recent logs:${RESET}"
  ls -lt "$LOG_DIR" 2>/dev/null | head -n 8 || true
  echo
}

# ---------------------------
# CLI
# ---------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --conf) CONF_PATH="$2"; shift 2 ;;
    --run) MODE="run"; shift ;;
    --print-config) MODE="print-config"; shift ;;
    --install) MODE="install"; shift ;;
    --uninstall) MODE="uninstall"; shift ;;
    --status) MODE="status"; shift ;;
    --version) echo "${APP_NAME} ${VERSION}"; exit 0 ;;
    -h|--help)
      cat <<HELP
${APP_TITLE} (${APP_NAME}) ${VERSION}

  Wizard (interactive):        ${SCRIPT_PATH}
  Wizard preview (dry-run):    ${SCRIPT_PATH} --dry-run
  Run with config:             ${SCRIPT_PATH} --run --conf ${DEFAULT_CONF}
  Run preview with config:     ${SCRIPT_PATH} --run --dry-run --conf ${DEFAULT_CONF}

  Print config template:       ${SCRIPT_PATH} --print-config
  Install schedule (config):   ${SCRIPT_PATH} --install --conf ${DEFAULT_CONF}
  Uninstall schedule:          ${SCRIPT_PATH} --uninstall
  Status:                      ${SCRIPT_PATH} --status

HELP
      exit 0
      ;;
    *)
      fail "Unknown arg: $1"
      exit 1
      ;;
  esac
done

# ---------------------------
# Main
# ---------------------------
case "$MODE" in
  print-config)
    print_config
    ;;
  status)
    show_status
    ;;
  uninstall)
    uninstall_schedule
    ;;
  install)
    if [[ ! -f "$CONF_PATH" ]]; then
      fail "Config not found: $CONF_PATH"
      note "Create one via: ${SCRIPT_PATH} (wizard) or ${SCRIPT_PATH} --print-config > $CONF_PATH"
      exit 1
    fi
    load_config
    install_launchagent_main
    install_login_summary
    install_pmset_wake
    ;;
  run)
    if [[ ! -f "$CONF_PATH" ]]; then
      fail "Config not found: $CONF_PATH"
      exit 1
    fi
    load_config
    run_cleanup
    ;;
  wizard|*)
    wizard
    ;;
esac

